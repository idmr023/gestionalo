includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 1
    paths:
        - app
        - config
        - database
        - routes
    excludePaths:
        analyseAndScan:
            - vendor (?)
            - node_modules (?)
            - storage (?)
            - bootstrap/cache (?)
    tmpDir: storage/framework/cache/phpstan

